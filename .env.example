# Публичный Client ID приложения Яндекс OAuth. Это не Client Secret.
VITE_YANDEX_CLIENT_ID=46564f36ea254c5da1a7717f0225a625

# Для локального запуска должен полностью совпадать с Redirect URI в Яндекс OAuth.
